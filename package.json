{
  "name": "caloos-climatologies",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf src/.observablehq/cache",
    "build": "observable build",
    "build:shore-station-data": "python3 src/data/shore_station_anomaly.zip.py > /tmp/shore_station_anomaly.zip && mv /tmp/shore_station_anomaly.zip src/data/shore_station_anomaly.zip",
    "dev": "observable preview",
    "dev:refresh": "npm run build:shore-station-data && observable preview",
    "deploy": "observable deploy",
    "observable": "observable",
    "install": "pip3 install -r requirements.txt",
    "test": "node --test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@observablehq/framework": "^1.13.4",
    "chart.js": "^4.5.1",
    "maplibre-gl": "^6.1.0"
  }
}
